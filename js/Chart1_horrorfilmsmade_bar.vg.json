{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "background": null,
    
    "width": 500,
    "height": 420,

    "data": {
      "url": "data/genre_counts_by_decade.csv"
    },

    "transform": [
      { "filter": "datum.Horror > 0" } 
    ],

    "layer": [

      {
        "params": [
          {
            "name": "horrorHover",
            "select": {
              "type": "point",
              "fields": ["decade"],
              "on": "mouseover",
              "clear": "mouseout"
            }
          }
        ],
        "mark": {
          "type": "bar",
          "color": "#b3122a",
          "cornerRadiusTopLeft": 3,
          "cornerRadiusTopRight": 3
        },
        "encoding": {
          "x": {
            "field": "decade",
            "type": "ordinal",
            "title": "Decades",
            "axis": {
              "labelAngle": 0,
              "labelFontSize": 11,
              "labelOverlap": "parity"
            }
          },
          "y": {
            "field": "Horror",
            "type": "quantitative",
            "title": "Horror films",
            "axis": {
              "format": ",.0f",
              "gridColor": "#eee"
            }
          },
          "opacity": {
            "condition": { "param": "horrorHover", "value": 1 },
            "value": 0.85
          },
          "tooltip": [
            { "field": "decade", "title": "Decade" },
            { "field": "Horror", "title": "Horror films", "format": ",.0f" },
            { "field": "all_films", "title": "All films", "format": ",.0f" }
          ]
        }
      },

      {
        "mark": {
          "type": "text",
          "dy": -7,
          "fontSize": 11,
          "fontWeight": "bold",
          "color": "#333"
        },
        "encoding": {
          "x": { "field": "decade", "type": "ordinal" },
          "y": { "field": "Horror", "type": "quantitative" },
          "text": {
            "field": "Horror",
            "type": "quantitative",
            "format": ",.0f"
          },
          "opacity": {
            "condition": {
              "param": "horrorHover",
              "empty": false,
              "value": 1
            },
            "value": 0
          }
        }
      }
    ],
    "config": {
      "view": { "stroke": null },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "titleFontSize": 12
      },
      "font": "Georgia, serif"
    }
  }