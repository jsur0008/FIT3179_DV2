{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,

    "width": 700,
    "height": 470,
    "projection": {
      "type": "conicEqualArea",
      "parallels": [-18, -36],
      "rotate": [-134, 0, 0],
      "center": [0, -27],
      "scale": 700,
      "translate": [260, 220]
    },
    "layer": [
      {
        "description": "Base map: outline of Australia (country shape from the world-atlas TopoJSON)",
        "data": {
          "url": "../data/world-50m.json",
          "format": { "type": "topojson", "feature": "countries" }
        },
        "transform": [
          { "filter": "datum.properties.name === 'Australia'" }
        ],
        "mark": { "type": "geoshape", "fill": "#ece9e4", "stroke": "#c9c4bb", "strokeWidth": 0.6 }
      },
      {
        "description": "Dots: one circle per cinema. Transparency makes crowded areas look darker.",
        "data": { "url": "../data/cinemas.csv" },
        "mark": {
          "type": "circle",
          "size": 100,
          "color": "#b91c1c",
          "opacity": 0.55,
          "stroke": "white",
          "strokeWidth": 0.4
        },
        "encoding": {
          "longitude": { "field": "lon", "type": "quantitative" },
          "latitude": { "field": "lat", "type": "quantitative" },
          "tooltip": [
            { "field": "name", "type": "nominal", "title": "Cinema" }
          ]
        }
      },
      {
        "description": "Reading note placed over the Great Australian Bight",
        "data": { "values": [{ "lon": 118, "lat": -36.2 }] },
        "mark": {
          "type": "text",
          "align": "left",
          "fontSize": 12,
          "lineHeight": 15,
          "color": "#555555"
        },
        "encoding": {
          "longitude": { "field": "lon", "type": "quantitative" },
          "latitude": { "field": "lat", "type": "quantitative" }
        }
      },
      {
        "description": "City labels placed to the right of the point",
        "data": {
          "values": [
            { "city": "Sydney", "lat": -33.87, "lon": 151.21 },
            { "city": "Brisbane", "lat": -27.47, "lon": 153.03 },
            { "city": "Hobart", "lat": -42.88, "lon": 147.33 }
          ]
        },
        "mark": { "type": "text", "align": "left", "dx": 10, "fontSize": 12, "fontWeight": "bold", "color": "#333333" },
        "encoding": {
          "longitude": { "field": "lon", "type": "quantitative" },
          "latitude": { "field": "lat", "type": "quantitative" },
          "text": { "field": "city" }
        }
      },
      {
        "description": "City labels placed to the left of the point",
        "data": {
          "values": [
            { "city": "Perth", "lat": -31.95, "lon": 115.86 },
            { "city": "Adelaide", "lat": -34.93, "lon": 138.6 },
            { "city": "Darwin", "lat": -12.46, "lon": 130.84 }
          ]
        },
        "mark": { "type": "text", "align": "right", "dx": -10, "fontSize": 12, "fontWeight": "bold", "color": "#333333" },
        "encoding": {
          "longitude": { "field": "lon", "type": "quantitative" },
          "latitude": { "field": "lat", "type": "quantitative" },
          "text": { "field": "city" }
        }
      },
      {
        "description": "City label placed below the point",
        "data": { "values": [{ "city": "Melbourne", "lat": -37.81, "lon": 144.96 }] },
        "mark": { "type": "text", "align": "center", "dy": 22, "fontSize": 12, "fontWeight": "bold", "color": "#333333" },
        "encoding": {
          "longitude": { "field": "lon", "type": "quantitative" },
          "latitude": { "field": "lat", "type": "quantitative" },
          "text": { "field": "city" }
        }
      }
    ],
    "config": {"view": {"stroke": null},
    "font": "Georgia, serif",
      "facet": {"spacing": 14}}
  }