{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {"url": "../data/horror_by_country_decade.csv"},
    "vconcat": [
      {
        "title": {
          "text": "Horror films by country of origin",
          "subtitle": "Totals for the decades selected on the line chart below",
          "anchor": "middle",
          "fontSize": 15,
          "subtitleFontSize": 12,
          "subtitleColor": "#555"
        },
        "width": 700,
        "height": 350,
        "view": {"stroke": "#cfcfcf"},
        "projection": {"type": "naturalEarth1"},
        "layer": [
          {
            "data": {"sphere": true},
            "mark": {"type": "geoshape", "fill": "#99cbe6"}
          },
          {
            "data": {"graticule": {"step": [30, 30]}},
            "mark": {"type": "geoshape", "fill": null, "stroke": "#ffffff", "strokeOpacity": 0.45, "strokeWidth": 0.6}
          },
          {
            "data": {"url": "../data/world-110m.json", "format": {"type": "topojson", "feature": "countries"}},
            "mark": {"type": "geoshape", "fill": "#d3d3d3", "stroke": "white", "strokeWidth": 0.5}
          },
          {
            "transform": [
              {"filter": {"param": "brush"}},
              {"aggregate": [{"op": "sum", "field": "films", "as": "films"}], "groupby": ["id", "country"]},
              {
                "lookup": "id",
                "from": {
                  "data": {"url": "../data/world-110m.json", "format": {"type": "topojson", "feature": "countries"}},
                  "key": "id"
                },
                "as": "geo"
              },
              {
                "calculate": "datum.films >= 5000 ? '5,000+' : datum.films >= 1000 ? '1,000–4,999' : datum.films >= 200 ? '200–999' : datum.films >= 50 ? '50–199' : datum.films >= 10 ? '10–49' : '1–9'",
                "as": "bucket"
              }
            ],
            "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
            "encoding": {
              "shape": {"field": "geo", "type": "geojson"},
              "color": {
                "field": "bucket",
                "type": "ordinal",
                "title": "Horror films",
                "scale": {
                  "domain": ["1–9", "10–49", "50–199", "200–999", "1,000–4,999", "5,000+"],
                  "range": ["#fbe3e6", "#f3b8c0", "#e5818f", "#cf4a5f", "#a50f2a", "#5c0814"]
                },
                "legend": {"orient": "right", "symbolType": "square", "titleFontSize": 12, "labelFontSize": 11}
              },
              "tooltip": [
                {"field": "country", "title": "Country"},
                {"field": "films", "title": "Horror films (selected years)", "format": ",.0f"}
              ]
            }
          },
          {
            "transform": [
              {"filter": {"param": "brush"}},
              {"aggregate": [{"op": "sum", "field": "films", "as": "films"}], "groupby": ["country"]},
              {"joinaggregate": [{"op": "max", "field": "films", "as": "top"}]},
              {"filter": "datum.films == datum.top"},
              {
                "calculate": "'Most horror films in the selected years: ' + datum.country + ' (' + format(datum.films, ',') + ')'",
                "as": "label"
              }
            ],
            "mark": {"type": "text", "align": "left", "baseline": "bottom", "fontStyle": "italic", "fontSize": 12, "color": "#5c0814", "dx": 12},
            "encoding": {
              "x": {"value": 0},
              "y": {"value": 336},
              "text": {"field": "label", "type": "nominal"}
            }
          }
        ]
      },
      {
        "title": {
          "text": "Drag across this line chart to choose the decades shown on the map",
          "anchor": "middle",
          "fontSize": 13
        },
        "width": 700,
        "height": 90,
        "transform": [
          {"aggregate": [{"op": "sum", "field": "films", "as": "films"}], "groupby": ["decade_start"]}
        ],
        "params": [
          {
            "name": "brush",
            "select": {"type": "interval", "encodings": ["x"]},
            "value": {"x": [2000, 2020]}
          }
        ],
        "mark": {"type": "line", "color": "#b3122a", "strokeWidth": 2, "point": {"filled": true, "size": 40, "color": "#b3122a"}},
        "encoding": {
          "x": {
            "field": "decade_start",
            "type": "quantitative",
            "title": null,
            "scale": {"domain": [1890, 2030], "nice": false},
            "axis": {"values": [1900, 1910, 1920, 1930, 1940, 1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020], "labelExpr": "datum.value + 's'", "labelFontSize": 10, "labelAngle": 0, "grid": true, "gridColor": "#e6e6e6"}
          },
          "y": {
            "field": "films",
            "type": "quantitative",
            "title": "Films",
            "axis": {"format": ",.0f", "tickCount": 3, "gridColor": "#e6e6e6"}
          },
          "tooltip": [
            {"field": "decade_start", "title": "Decade starting"},
            {"field": "films", "title": "Horror films", "format": ",.0f"}
          ]
        }
      }
    ],
    "config": {
      "view": {"stroke": null},
      "axis": {"domain": false, "ticks": false, "labelFontSize": 11, "titleFontSize": 11},
      "font": "Georgia, serif"
    }
  }