{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": null,
    "width": 800,
    "height": 410,
    "params": [
      {
        "name": "decade_sel",
        "value": 0,
        "bind": {
          "input": "select",
          "options": [0, 1980, 1990, 2000, 2010, 2020],
          "labels": ["All decades", "1980s", "1990s", "2000s", "2010s", "2020s"],
          "name": "Decade  "
        }
      },
      {
        "name": "min_films",
        "value": 2,
        "bind": { "input": "range", "min": 1, "max": 5, "step": 1, "name": "Routes with at least this many films  " }
      },{
        "name": "cam",
        "value": {"s": 140.4, "x": 380, "y": 200},
        "on": [
          {
            "events": {"type": "wheel", "consume": true},
            "update": "{s: clamp(cam.s * pow(1.0005, -event.deltaY * pow(16, event.deltaMode)), 140.4, 2000), x: xy()[0] - (xy()[0] - cam.x) * clamp(cam.s * pow(1.0005, -event.deltaY * pow(16, event.deltaMode)), 140.4, 2000) / cam.s, y: xy()[1] - (xy()[1] - cam.y) * clamp(cam.s * pow(1.0005, -event.deltaY * pow(16, event.deltaMode)), 140.4, 2000) / cam.s}"
          },
          {
            "events": "[pointerdown, window:pointerup] > window:pointermove",
            "update": "anchor ? {s: cam.s, x: anchor.cx + xy()[0] - anchor.px, y: anchor.cy + xy()[1] - anchor.py} : cam"
          },
          {
            "events": "dblclick",
            "update": "{s: 140.4, x: 380, y: 200}"
          }
        ]
      },
      {
        "name": "anchor",
        "value": null,
        "on": [
          {"events": "pointerdown", "update": "{px: xy()[0], py: xy()[1], cx: cam.x, cy: cam.y}"}
        ]
      }
    ],
    "projection": {
  "type": "equalEarth",
  "scale": {"expr": "cam.s"},
  "translate": {"expr": "[cam.x, cam.y]"}
},
    "layer": [
      {
        "data": { "sphere": true },
        "mark": { "type": "geoshape", "fill": "#faf6f2", "stroke": "#d9cfc7", "strokeWidth": 0.8 }
      },
      {
        "data": { "url": "data/world-110m.json", "format": { "type": "topojson", "feature": "countries" } },
        "mark": { "type": "geoshape", "fill": "#e6dcd4", "stroke": "#faf6f2", "strokeWidth": 0.5 }
      },
      {
        "data": { "url": "data/horror_connections.json" },
        "transform": [
          { "filter": "(decade_sel == 0 || datum.decade_start == decade_sel) && datum.films >= min_films" }
        ],
        "mark": { "type": "geoshape", "fill": null, "stroke": "#b3122a", "strokeOpacity": 0.3, "strokeCap": "round" },
        "encoding": {
          "shape": { "field": "geo", "type": "geojson" },
          "strokeWidth": {
            "field": "films",
            "type": "quantitative",
            "scale": { "type": "sqrt", "range": [0.6, 3.5] },
            "legend": null
          },
          "tooltip": [
            { "field": "set_in", "title": "Story set in" },
            { "field": "filmed_in", "title": "Filmed in" },
            { "field": "films", "title": "Films" },
            { "field": "example", "title": "For example" }
          ]
        }
      },
      {
        "data": {"values": [{"t": "Scroll to zoom · drag to move · double-click to reset"}]},
        "mark": {"type": "text", "align": "center", "baseline": "top", "fontSize": 11, "color": "#777777"},
        "encoding": {
          "x": {"value": 370},
          "y": {"value": 390},
          "text": {"field": "t"}
        }
      },
      {
        "data": { "url": "data/horror_connections.json" },
        "transform": [
          { "filter": "(decade_sel == 0 || datum.decade_start == decade_sel) && datum.films >= min_films" },
          {
            "aggregate": [{ "op": "sum", "field": "films", "as": "films" }],
            "groupby": ["set_in", "set_in_country", "set_lon", "set_lat"]
          },
          { "calculate": "'Story set here'", "as": "role" }
        ],
        "mark": { "type": "circle", "stroke": "#ffffff", "strokeWidth": 1, "opacity": 0.95 },
        "encoding": {
          "longitude": { "field": "set_lon", "type": "quantitative" },
          "latitude": { "field": "set_lat", "type": "quantitative" },
          "size": {
            "field": "films",
            "type": "quantitative",
            "scale": { "type": "sqrt", "domain": [0, 100], "range": [10, 380] },
            "legend": null
          },
          "color": {
            "field": "role",
            "type": "nominal",
            "scale": { "domain": ["Story set here", "Filmed here"], "range": ["#1f2a44", "#b3122a"] },
            "legend": {
              "title": null,
              "orient": "bottom-left",
              "direction": "vertical",
              "symbolType": "circle",
              "labelFontSize": 13
            }
          },
          "order": { "field": "films", "type": "quantitative", "sort": "descending" },
          "tooltip": [
            { "field": "set_in", "title": "Story set in" },
            { "field": "set_in_country", "title": "Country" },
            { "field": "films", "title": "Films (routes)", "format": ",.0f" }
          ]
        }
      },
      {
        "data": { "url": "data/horror_connections.json" },
        "transform": [
          { "filter": "(decade_sel == 0 || datum.decade_start == decade_sel) && datum.films >= min_films" },
          {
            "aggregate": [{ "op": "sum", "field": "films", "as": "films" }],
            "groupby": ["filmed_in", "filmed_in_country", "shot_lon", "shot_lat"]
          },
          { "calculate": "'Filmed here'", "as": "role" }
        ],
        "mark": { "type": "circle", "stroke": "#ffffff", "strokeWidth": 1, "opacity": 0.95 },
        "encoding": {
          "longitude": { "field": "shot_lon", "type": "quantitative" },
          "latitude": { "field": "shot_lat", "type": "quantitative" },
          "size": {
            "field": "films",
            "type": "quantitative",
            "title": "Films (routes)",
            "scale": { "type": "sqrt", "domain": [0, 100], "range": [10, 380] },
            "legend": {
              "orient": "bottom-right",
              "values": [5, 25, 50, 100],
              "symbolFillColor": "#999999",
              "titleFontSize": 12,
              "labelFontSize": 11
            }
          },
          "color": {
            "field": "role",
            "type": "nominal",
            "scale": { "domain": ["Story set here", "Filmed here"], "range": ["#1f2a44", "#b3122a"] },
            "legend": null
          },
          "order": { "field": "films", "type": "quantitative", "sort": "descending" },
          "tooltip": [
            { "field": "filmed_in", "title": "Filmed in" },
            { "field": "filmed_in_country", "title": "Country" },
            { "field": "films", "title": "Films (routes)", "format": ",.0f" }
          ]
        }
      },
      {
        "data": { "url": "data/horror_connections.json" },
        "transform": [
          { "filter": "(decade_sel == 0 || datum.decade_start == decade_sel) && datum.films >= min_films" },
          {
            "aggregate": [{ "op": "sum", "field": "films", "as": "films" }],
            "groupby": ["set_in_country", "filmed_in_country"]
          },
          {
            "window": [{ "op": "row_number", "as": "rn" }],
            "sort": [
              { "field": "films", "order": "descending" },
              { "field": "set_in_country", "order": "ascending" }
            ]
          },
          { "filter": "datum.rn == 1" },
          {
            "calculate": "'Most common route: set in ' + datum.set_in_country + ', filmed in ' + datum.filmed_in_country + ' (' + datum.films + ' films)'",
            "as": "label"
          }
        ],
        "mark": {
          "type": "text",
          "align": "center",
          "baseline": "top",
          "fontStyle": "italic",
          "fontSize": 13,
          "color": "#1f2a44",
          "dx": 12
        },
        "encoding": {
          "x": { "value": 370 },
          "y": { "value": 0},
          "text": { "field": "label", "type": "nominal" }
        }
      }
    ],
    "config": {
      "view": { "stroke": null, "clip": true },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 13,
        "titleFontSize": 14
      },
      "font": "Georgia, serif"
      }
    }
  